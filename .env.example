# Stripe keys for the "Pull from Stripe" lookup. One per account; the label
# after STRIPE_KEY_ is only used for display. All accounts are tried in order.
#
# Use RESTRICTED READ-ONLY keys, never the live secret key:
#   Stripe dashboard > Developers > API keys > Create restricted key
#   Grant read access to Charges, Checkout Sessions and Customers only.
#
# STRIPE_KEY_MYCOMPANY=rk_live_...
# STRIPE_KEY_SIDEPROJECT=rk_live_...
